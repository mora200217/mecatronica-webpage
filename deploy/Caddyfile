{
	# Let's Encrypt rechaza admin@localhost. Este correo no necesita
	# bandeja real; solo un dominio con punto.
	email {$ACME_EMAIL:admin@ingmecatronicaunal.site}
}

{$SITE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy frontend:80
}
