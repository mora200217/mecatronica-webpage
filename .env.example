# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# En local puedes dejarlo tal cual; en el servidor cambia TODAS las contraseñas.

# --- Base de datos ---
POSTGRES_DB=mecatronica
POSTGRES_USER=mecatronica
POSTGRES_PASSWORD=cambia-esta-clave
# Puerto en tu máquina para conectarte a Postgres desde fuera (solo desarrollo).
POSTGRES_PORT_HOST=5433

# --- Django ---
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-llave
DJANGO_DEBUG=false
# En el servidor pon la IP o el dominio. El asterisco evita el 400 de Django.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ORIGINS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
# true cuando ya tengas HTTPS
DJANGO_SECURE_COOKIES=false

# Usuario del panel /admin/. En el servidor pon una clave larga.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave-del-admin
DJANGO_SUPERUSER_EMAIL=admin@localhost

# --- Web ---
# Puerto público del sitio. En el servidor déjalo en 80,
# o ponlo en 8080 si vas a usar Caddy con HTTPS (perfil tls).
WEB_PORT=80

# Dominio para el certificado automático de Caddy (perfil tls).
SITE_DOMAIN=mecatronica.example.com
