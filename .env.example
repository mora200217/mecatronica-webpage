# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# En local puedes dejarlo tal cual; en el servidor cambia TODAS las contraseñas.

# --- Base de datos ---
POSTGRES_DB=mecatronica
POSTGRES_USER=mecatronica
POSTGRES_PASSWORD=cambia-esta-clave
# Puerto en tu máquina para conectarte a Postgres desde fuera (solo desarrollo).
POSTGRES_PORT_HOST=5433

# --- Django ---
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-llave
DJANGO_DEBUG=false
# Con SITE_DOMAIN, Django añade solo esos hosts. El asterisco vale si aún
# quieres entrar por la IP mientras el DNS propaga.
DJANGO_ALLOWED_HOSTS=backend
DJANGO_CORS_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Usuario del panel /admin/. En el servidor pon una clave larga.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave-del-admin
DJANGO_SUPERUSER_EMAIL=admin@ingmecatronicaunal.site

# --- HTTPS (producción) ---
# Dominio comprado. Caddy pide el certificado a Let's Encrypt y lo renueva solo.
# Si también usas www, agrégalo (con espacio después de la coma) y crea el A de www.
SITE_DOMAIN=ingmecatronicaunal.site
ACME_EMAIL=admin@ingmecatronicaunal.site
